<%= form_with(model: reservation_room) do |form| %>
  <% if reservation_room.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(reservation_room.errors.count, "error") %> prohibited this reservation_room from being saved:</h2>

      <ul>
        <% reservation_room.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :date, style: "display: block" %>
    <%= form.datetime_field :date %>
  </div>

  <div>
    <%= form.label :user_id, style: "display: block" %>
    <input name='reservation_room[user_id]' value="<%= reservation_room&.user&.name %>" />
  </div>

  <div>
    <%= form.label :room_id, style: "display: block" %>
    <input type="text" placeholder="Nome" name='reservation_room[room_id]' value="<%= reservation_room.room&.name %>" />
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
